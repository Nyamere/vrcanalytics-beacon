[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/

# OS / IDE noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build artifacts produced by the release workflow (the workflow handles the zip).
*.zip
